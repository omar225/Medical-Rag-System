# Keep source bytes (the KB checksums) and line endings identical on every checkout.
*.docx binary
*.pdf binary
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.ini text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
