# Optional: copy to .env and start Uvicorn with --env-file .env.
# LLM integration is pending; Stage 3 retrieval initially uses local BGE-M3.
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# Stage 3 local dense retrieval. No models are downloaded automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
EMBEDDING_BATCH_SIZE=8
# Optional: RETRIEVAL_INDEX_DIR=storage/vector_store/dense
# Optional Stage 3.1 reviewed aliases; dense baseline does not use them.
# RETRIEVAL_ALIASES_FILE=data/knowledge_base/metadata/retrieval_aliases.json

# Optional only when explicitly running the live integration test:
# RUN_OLLAMA_TESTS=1
# Qwen is a future LLM candidate; no Qwen download is needed for current stages.
