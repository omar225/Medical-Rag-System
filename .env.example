# Optional: copy to .env and start Uvicorn with --env-file .env.
# Stage 4A generation. Models must already be installed; nothing auto-downloads.
LLM_MODEL=qwen3.5:4b
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=768
LLM_CONTEXT_SIZE=8192
LLM_TIMEOUT_SECONDS=25
CHAT_TIMEOUT_SECONDS=30
# Later comparison candidate: LLM_MODEL=qwen2.5:7b (not downloaded or evaluated).
EMBEDDING_MODEL=bge-m3

# Stage 3 local dense retrieval. No models are downloaded automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
EMBEDDING_BATCH_SIZE=8
# Optional: RETRIEVAL_INDEX_DIR=storage/vector_store/dense
# Optional Stage 3.1 reviewed aliases; dense baseline does not use them.
# RETRIEVAL_ALIASES_FILE=data/knowledge_base/metadata/retrieval_aliases.json

# Optional only when explicitly running the live integration test:
# RUN_OLLAMA_TESTS=1
# RUN_CHAT_TESTS=1 enables separate live Qwen + hybrid API checks.
