# Copy to .env to override defaults (docker compose reads it automatically). No secrets are needed.

# Models (open weights, served by Ollama). Changing EMBEDDING_MODEL rebuilds the index on next start.
LLM_MODEL=qwen3.5:4b
EMBEDDING_MODEL=bge-m3

# Generation limits
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_SIZE=8192
LLM_TIMEOUT_SECONDS=25
# Whole-request budget (the API contract allows 30 s); a corrective retry needs this much time left:
CHAT_TIMEOUT_SECONDS=28
LLM_RETRY_MIN_SECONDS=10

# Local (non-Docker) runs
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
EMBEDDING_BATCH_SIZE=8
# RETRIEVAL_INDEX_DIR=storage/vector_store/dense
# INDEX_BUILD_WAIT_SECONDS=0      # Docker sets 900 so startup waits for the model download
# PRELOAD_ON_STARTUP=1            # build the service at startup instead of on the first request

# Docker only
# APP_PORT=8000
# OLLAMA_IMAGE=ollama/ollama:0.40.15

# Opt-in live tests: RUN_CHAT_TESTS=1, RUN_OLLAMA_TESTS=1
