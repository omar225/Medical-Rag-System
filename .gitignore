.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
!.env.example
.vscode/

# Only the approved-nine Stage 2.1 ingestion JSON is versioned.
# Other candidate outputs, temporary files, and new document IDs remain ignored.
data/knowledge_base/processed/*
!data/knowledge_base/processed/KB-0[1-9].json
data/knowledge_base/chunks/*
!data/knowledge_base/chunks/KB-0[1-9].json
data/knowledge_base/metadata/generated/*
!data/knowledge_base/metadata/generated/ingestion_manifest.json

# Runtime and generated storage
storage/vector_store/
storage/sessions/
storage/analytics/
storage/logs/
*.db
*.sqlite
*.sqlite3
*.log

# Downloaded models and large generated artifacts
models/
*.pt
*.pth
*.safetensors
*.bin

# Reports and temporary files
reports/evaluation/
reports/performance/
reports/frontend/
tmp/
temp/

# Local handoff verification environments and credentials
.handoff-verification/
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.gguf
*.npy
*.npz
# The reviewed recovery archive is explicitly selected, not a runtime cache.
